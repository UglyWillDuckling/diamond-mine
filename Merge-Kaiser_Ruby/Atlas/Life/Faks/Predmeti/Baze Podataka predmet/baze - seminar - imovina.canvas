{
	"nodes":[
		{
			"id":"e57d79763764331e",
			"type":"text",
			"text":"## Evidencija imovine",
			"dynamicHeight":false,
			"styleAttributes":{"textAlign":"center"},
			"x":-1830,
			"y":-760,
			"width":2240,
			"height":80
		},
		{
			"id":"4d4922cb7fbee0ca",
			"type":"text",
			"text":"```sql\nCREATE TABLE sredstvo (\n    id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,\n    inventarni_broj NUMBER NOT NULL UNIQUE,\n\t\t\n    naziv VARCHAR2(255) NOT NULL,\n    opis VARCHAR2(1000) NOT NULL,\n\n    datum_aktivacije DATE DEFAULT SYSDATE NOT NULL,\n\n    status VARCHAR2(20) DEFAULT 'u izradi' NOT NULL,\n    CONSTRAINT chk_sredstvo_status\n        CHECK (status IN ('u izradi', 'aktivno', 'rashodovano', 'otpisano')),\n\n    trenutna_vrijednost NUMBER(15,2) NOT NULL CHECK (trenutna_vrijednost >= 0),\n    nabavna_vrijednost NUMBER(15,2) NOT NULL,\n    godisnji_iznos_amortizacije NUMBER(15,2) DEFAULT 0 NOT NULL,\n    ukupni_iznos_amortizacija NUMBER(15,2) DEFAULT 0 NOT NULL,\n    datum_amortizacije DATE,\n    am_grupa NUMBER NOT NULL,\n    CONSTRAINT fk_sredstvo_am_grupa\n        FOREIGN KEY (am_grupa)\n        REFERENCES amortizacijska_grupa(id)\n);\nCREATE INDEX idx_sredstvo_am_grupa ON sredstvo (am_grupa);\n```",
			"dynamicHeight":false,
			"styleAttributes":{},
			"x":-1720,
			"y":-207,
			"width":680,
			"height":680,
			"color":"3"
		},
		{
			"id":"f7f7e19df6139dba",
			"type":"text",
			"text":"### amortizacijska grupa\n- sifra\n- naziv\n- stopa amortizacije\n- osnovni konto\n\n",
			"dynamicHeight":false,
			"styleAttributes":{},
			"x":-960,
			"y":-577,
			"width":250,
			"height":280,
			"color":"#fbb1e4"
		},
		{
			"id":"4f819858d117f92b",
			"type":"text",
			"text":"### sredstvo\n- naziv\n- opis\n- datum_aktivacije\n- status (u izradi, aktivno, rashodovanoj, otpisano)\n- trenutna_vrijednost\n- nabavna_vrijednost\n- godisnji_iznos_amortizacije\n- ukupni_iznos_amortizacija\n- datum_amortizacije\n- am. grupa id\n- inventarni broj",
			"dynamicHeight":false,
			"styleAttributes":{},
			"x":-1380,
			"y":-632,
			"width":320,
			"height":390,
			"color":"3"
		},
		{
			"id":"3d860ae8050ed33d",
			"type":"text",
			"text":"### konto\n- sifra\n- naziv\n- status_konta (aktivan, neaktivan)\n- tip_konta (dugovni, potrazni)",
			"dynamicHeight":true,
			"styleAttributes":{},
			"x":-592,
			"y":-507,
			"width":275,
			"height":160
		},
		{
			"id":"7de9f8c5e5fef215",
			"type":"text",
			"text":"### **transakcija**\n- datum\n- vrsta\n\t- nabava\n\t- aktivacija\n\t- rashod\n\t- otpis\n\t- godisnja amortizacija",
			"dynamicHeight":true,
			"styleAttributes":{},
			"x":-206,
			"y":-627,
			"width":260,
			"height":240,
			"color":"5"
		},
		{
			"id":"9b7da3f8c0265303",
			"type":"text",
			"text":"```sql\nCREATE TABLE transakcije (\n\tid NUMBER PRIMARY KEY AUTO_INCREMENT,\n\tdatum NOT NULL DEFAULT SYSDATE,\n\tvrsta VARCHAR(32) NOT NULL CHECK STATUS IN (\n\t\t'nabava', 'aktivacija',\t'rashod', 'otpis', 'godisnja_amortizacija')\n),\nentity_id INT NOT NULL\n```",
			"dynamicHeight":true,
			"styleAttributes":{},
			"x":-145,
			"y":-347,
			"width":700,
			"height":220,
			"color":"5"
		},
		{
			"id":"5990f662247436e4",
			"type":"text",
			"text":"```sql\nCREATE TABLE amortizacijska_grupa (\n\tid INT PRIMARY KEY AUTO_INCREMENT,\n\tsifra INT NOT NULL,\n\tnaziv VARCHAR(32) NOT NULL,\n\tstopa_amortizacije DECIMAL(10, 2) NOT NULL,\n\tosnovni_konto INT NOT NULL,\n\t\n\tFOREIGN KEY(osnovni_konto) REFERENCES konto(id)\n)\n```",
			"dynamicHeight":true,
			"styleAttributes":{},
			"x":-917,
			"y":-40,
			"width":650,
			"height":260,
			"color":"#ffd1f0"
		},
		{
			"id":"3755d4de265aecb3",
			"type":"text",
			"text":"```sql\nCREATE TABLE konto (\n\tid INT PRIMARY KEY AUTO_INCREMENT,\n\tsifra INT NOT NULL,\n\tnaziv VARCHAR(32),\n\tstatus_konta VARCHAR(16) NOT NULL CHECK status_konta IN ('aktivan', 'neaktivan'),\n\ttip_konta VARCHAR(16) NOT NULL CHECK tip_konta IN ('dugovni', 'potrazni')\n)\n```",
			"dynamicHeight":false,
			"styleAttributes":{},
			"x":-917,
			"y":320,
			"width":772,
			"height":270
		},
		{
			"id":"94e2176d03e017f3",
			"type":"text",
			"text":"## VIEW - pregled imovine\n\n```sql\nCREATE OR REPLACE VIEW pregled_imovine AS\nSELECT \n    sr.inventarni_broj,\n    sr.opis,\n    sr.am_grupa,\n    sr.nabavna_vrijednost,\n    sr.trenutna_vrijednost,\n    ag.naziv AS naziv_am_grupe,\n    ag.sifra AS sifra_am_grupe\nFROM sredstvo sr\nINNER JOIN amortizacijska_grup ag ON sr.am_grupa = ag.id\n```",
			"dynamicHeight":false,
			"styleAttributes":{},
			"x":-1980,
			"y":520,
			"width":760,
			"height":385,
			"color":"4"
		},
		{
			"id":"d4ecb6a9c60b34e5",
			"type":"text",
			"text":"## notes 🗒\n\n- [[baze - seminar]]",
