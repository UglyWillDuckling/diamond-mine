filters:
  or:
    - file.hasTag("kviz")
views:
  - type: table
    name: Table
    order:
      - file.name
      - datum
      - bodovi
    sort:
      - property: datum
        direction: DESC
      - property: file.name
        direction: ASC
      - property: bodovi
        direction: ASC
    summaries:
      bodovi: Average
    columnSize:
      file.name: 248
